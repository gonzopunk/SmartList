rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return isSignedIn() ? request.auth.token.get('email', '').lower() : '';
    }

    function isMember(listId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // pendingEmails is optional, so always read it through a default.
    function incomingPending() {
      return incoming().get('pendingEmails', []);
    }

    function existingPending() {
      return existing().get('pendingEmails', []);
    }

    // Phase 4: Entity Validations

    // Shape only. Deliberately says nothing about createdAt's *value* so it can
    // be reused for updates, where createdAt is an existing past timestamp.
    function isValidListShape(data) {
      return data.keys().hasAll(['name', 'ownerId', 'members', 'createdAt'])
        && data.keys().hasOnly(['name', 'ownerId', 'members', 'createdAt', 'pendingEmails'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.ownerId is string
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 50
        && data.get('pendingEmails', []) is list && data.get('pendingEmails', []).size() <= 50
        && data.createdAt is timestamp;
    }

    function isValidNewList(data) {
      return isValidListShape(data)
        && data.createdAt == request.time
        && data.ownerId == request.auth.uid
        && data.members == [request.auth.uid];
    }

    // Fields no update may ever touch.
    function preservesListIdentity() {
      return incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt;
    }

    function touchesOnlyMembershipKeys() {
      return incoming().diff(existing()).affectedKeys().hasOnly(['name', 'members', 'pendingEmails']);
    }

    // Owner: full control over name and membership, but cannot orphan the list
    // by removing themselves.
    function isOwnerManagingList() {
      return request.auth.uid == existing().ownerId
        && touchesOnlyMembershipKeys()
        && existing().ownerId in incoming().members;
    }

    // Non-owner member: may rename and invite, but never remove anyone.
    function isMemberInviting() {
      return request.auth.uid in existing().members
        && touchesOnlyMembershipKeys()
        && incoming().members.hasAll(existing().members);
    }

    // Anyone holding the list id (share link) or pre-invited by email may add
    // exactly themselves, and may clear at most their own pending invite.
    function isSelfJoining() {
      return !(request.auth.uid in existing().members)
        && incoming().diff(existing()).affectedKeys().hasOnly(['members', 'pendingEmails'])
        && incoming().members.hasAll(existing().members)
        && incoming().members.size() == existing().members.size() + 1
        && request.auth.uid in incoming().members
        && existingPending().hasAll(incomingPending())
        && incomingPending().size() >= existingPending().size() - 1
        && !(authEmail() in incomingPending());
    }

    function isValidListItem(data) {
      return data.keys().hasAll(['name', 'originalName', 'category', 'isStaple', 'isPurchased', 'quantity', 'addedBy', 'updatedAt'])
        && data.keys().size() >= 8 && data.keys().size() <= 11
        && data.name is string && data.name.size() <= 100
        && data.originalName is string && data.originalName.size() <= 100
        && data.category is string && data.category.size() <= 50
        && data.quantity is string && data.quantity.size() <= 50
        && data.isStaple is bool
        && data.isPurchased is bool
        && (data.keys().hasAny(['isInLibrary']) ? data.isInLibrary is bool : true)
        && (data.keys().hasAny(['frequency']) ? data.frequency in ['staple', 'occasional', 'special'] : true)
        && data.updatedAt == request.time;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email', 'updatedAt'])
        && data.keys().size() >= 3 && data.keys().size() <= 4
        && data.displayName is string && data.displayName.size() <= 100
        && data.email is string && data.email.size() <= 100
        && data.updatedAt == request.time;
    }

    // Match Groups
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allows searching by email
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    match /lists/{listId} {
      // Invariant: a list is only readable by its members, or by someone whose
      // email is already on the pending invite list.
      function canReadList() {
        return isSignedIn() && (
          request.auth.uid in existing().members ||
          authEmail() in existingPending()
        );
      }

      allow get: if canReadList();
      allow list: if canReadList();

      allow create: if isSignedIn() && isValidId(listId) && isValidNewList(incoming());

      allow update: if isSignedIn()
        && isValidListShape(incoming())
        && preservesListIdentity()
        && (isOwnerManagingList() || isMemberInviting() || isSelfJoining());

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      match /items/{itemId} {
        allow read: if isMember(listId);
        allow create: if isMember(listId) && isValidId(itemId) && isValidListItem(incoming()) && incoming().addedBy == request.auth.uid;
        allow update: if isMember(listId) && isValidListItem(incoming()) && (
          // Action: Toggle check/edit/library move
          incoming().addedBy == existing().addedBy &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'originalName', 'category', 'isStaple', 'frequency', 'isPurchased', 'isInLibrary', 'quantity', 'updatedAt'])
        );
        allow delete: if isMember(listId);
      }
    }
  }
}
